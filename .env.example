# Bot token from @BotFather
TOKEN=123456:replace-with-your-bot-token

# Telegram user IDs of the admins, comma separated
ADMINS_ID=11111111,22222222

# API keys of the Telegram account that reads the channels, from my.telegram.org
API_ID=1234567
API_HASH=replace-with-your-api-hash

# Modules to run: mentions, leads or mentions,leads; mentions when empty
MODULES=mentions,leads

# Optional AI check of leads: an OpenAI-compatible API, OpenRouter when AI_BASE_URL is empty
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=https://openrouter.ai/api/v1
